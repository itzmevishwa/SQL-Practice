/* Retrieve all students aged
19 or older */

select * 
from students
where age >= 19

/* Retrieve students names "William Turner" or
"Alice Brown" */

select *
from students
where Name = "Willian Turner" or name ="Alice Brown"

-- OR ---------------
select * 
from students
where Name in("Willian Turner", "Alice Brown")

/* Retreive students with grades A OR B and aged 20 or older*/

select * 
from students
where FinalGrade in ("A", "B")
and Age >= 20

/* Retrieve students age between 18 and 20*/

select *
from students
where Age between 18 and 20

/*Retrieve Students with grades greater than "A"*/
 
 select * 
 from students
 where FinalGrade > "A"

/* Count the total number of students*/

select count(name) as total_students
from students

/* Calculate the average age of Students*/

select avg(age) as average_age
from students

/* Find the sum of Ages for students with grades
A OR B)*/

select sum(age) 
from students
where FinalGrade in ("A", "B")

/* Group students by grade and count the
number of students in each grade*/

select count(Name) ,
FinalGrade 
from students
group by FinalGrade
order by finalgrade asc

/* Group students by age and calculate the average age 
in each group*/

select  avg(age), finalgrade
from students
group by finalgrade


/*Fimd grades with an average age greater than 22*/

select avg(age), finalgrade
from students

group by finalgrade
having avg(age) > 21

