/* Create a table name students
ID, Name , Age*/

create table Students (
ID int primary key,
Name Varchar(100) not null,
Age int not null
)

/* Add a new column "Grade" to the 
Student table*/

alter table students add column Grade Varchar(100)

/* Rename the Grade column to Final Grade*/

alter table Students change  Grade FinalGrade Varchar(100)

